{
  "name": "@yuxhangz/dsh-session-manager",
  "version": "0.1.16",
  "type": "module",
  "description": "Nested session folders in the DSH sidebar: folders, tags, and activity counts you can click to jump.",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "sessions", "folders", "sidebar", "tags"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/XinAnzzZ/dsh-session-manager.git" },
  "homepage": "https://github.com/XinAnzzZ/dsh-session-manager#readme",
  "bugs": { "url": "https://github.com/XinAnzzZ/dsh-session-manager/issues" },
  "publishConfig": { "access": "public" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "build": "node build.cjs", "test": "node --test test/*.test.cjs", "check": "node --check client.js && node --check index.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-workspace"] }
  }
}
